{
	"mcpServers": {
		"ayrshare": {
			"type": "http",
			"url": "https://api.ayrshare.com/mcp",
			"headers": {
				"Authorization": "Bearer ${user_config.api_key}",
				"Profile-Key": "${user_config.profile_key}",
				"X-Twitter-OAuth1-Api-Key": "${user_config.x_api_key}",
				"X-Twitter-OAuth1-Api-Secret": "${user_config.x_api_secret}"
			}
		}
	}
}
